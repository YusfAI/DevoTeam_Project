# Copie ce fichier en ".env".
# Ne commit JAMAIS le fichier ".env" réel dans git (voir .gitignore).

# --- Modèle local (Ollama) : interprétation des questions du chat ---
# Aucune clé API. Laisser vide pour utiliser les valeurs par défaut du code
# (http://localhost:11434 et qwen2.5:7b-instruct-q4_K_M) — à renseigner seulement si
# Ollama tourne sur un autre port/hôte, ou pour changer de modèle.
OLLAMA_HOST=
OLLAMA_MODEL=

# --- Alertes deadline (email quotidien pour les opportunités actives à échéance ≤ 7 jours) ---
# GMAIL_APP_PASSWORD : génère un mot de passe d'application sur https://myaccount.google.com/apppasswords
# (nécessite la validation en 2 étapes activée sur le compte GMAIL_SENDER) — pas le mot de passe Gmail normal.
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
# Une adresse, ou plusieurs séparées par une virgule : destinataire1@exemple.com,destinataire2@exemple.com
ALERT_RECIPIENT_EMAIL=

# --- Google Sheet : source de données unique de l'application (voir README.md) ---
# Lecture seule, via une clé API Google (aucun fichier de compte de service, aucun
# OAuth) : console.cloud.google.com > APIs & services > Identifiants > Créer une
# clé API, puis activer l'API "Google Sheets API" sur le projet. Le Sheet doit être
# partagé en "Lecteur — toute personne disposant du lien" (Partager > Accès général).
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=opportunities

# --- Acces public (tunnel ngrok, reverse proxy) ---
# L'adresse que le NAVIGATEUR doit employer pour charger les tableaux de bord.
# A ne renseigner QUE si l'application est consultee depuis une autre machine :
# le backend continue de sonder 127.0.0.1, mais un navigateur distant qui recoit
# cette adresse interroge la sienne, et tous les tableaux de bord restent vides
# sans qu'aucune requete n'echoue.
# Voir scripts/start_public.bat.
DAC_PUBLIC_URL=
DAC_DARK_PUBLIC_URL=
