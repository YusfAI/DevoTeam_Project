# Secrets
.env
credentials/
*.iam.gserviceaccount.com.json
devoteam-*.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Frontend (Vite/React)
frontend/node_modules/
frontend/dist/

# Éditeurs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Misc
out.txt
*.log

# État local du scheduler (anti-doublon des alertes email) — régénéré au besoin
data/scheduler_state.json

# Projection DuckDB pour les dashboards DAC — régénérée à chaque rafraîchissement
# depuis le Google Sheet (backend/duckdb_export.py), jamais éditée à la main
dac/data/*.db

# Dashboard généré à chaque question du chat (backend/dac_composer.py) : artefact
# éphémère réécrit en permanence, sans intérêt en revue — contrairement aux cinq
# sections du tableau de bord principal (accueil.yml, section_*.yml) et à
# qualite.yml, qui sont des sources versionnées et relues.
dac/dashboards/_analyse_*.yml
# Le tableau de bord de travail, reecrit par CHAQUE question : meme raison, c'est un
# artefact d'execution et non une source.
dac/dashboards/_principal.yml

logs/queries
.bruin.yml
# Documentation de reference installee a la demande par `dac skills install` :
# fichier tiers, regenerable, sans interet en revue.
dac/.claude/
dac/.codex/

# Fichiers provisoires de l'ecriture atomique des dashboards (backend/dac_composer.py)
.dac_tmp/

# État d'exécution du planificateur (anti-doublon du digest quotidien) : propre à
# une machine et réécrit à chaque envoi, il n'a rien à faire dans le dépôt.
data/scheduler_state.json

# Journaux des requêtes, écrits à l'exécution.
logs/
